	(text "LEDs, each one color, series resistor sized for 2 mA: PWR from P3V3-good, AFE from AD9084 IRQ-not, FPGA from done, USB from FX20, LINK from QSFP ModPrsL and link-up, TX only when PA_EN_A or PA_EN_B is high, FAULT from SEQ_FAULT. TX lit means the drain switch is armed, not merely that software set a bit."
		(at 20.00 210.00 0)
		(effects (font (size 1.27 1.27)))
		(uuid "79d8fed4-af63-5bd9-92c8-c7d0dc1e8c7c")
